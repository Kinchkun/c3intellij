<idea-plugin>
  <id>org.c3lang.c3intellij</id>
  <name>C3 Language Support</name>
  <vendor url="https://www.c3-lang.org">C3 Lang</vendor>
  <description><![CDATA[
        <p>Support for the [C3 Language](https://c3-lang.org/) in IntelliJ, CLion and many others.</p>
        <p>The plugin, which is part of the official C3 project, is available on [Github](https://github.com/c3lang/c3intellij).</p>
    ]]></description>
  
  <depends>com.intellij.modules.platform</depends>
  <depends optional="true" config-file="cidrdebugger.xml">com.intellij.modules.cidr.debugger</depends>

  <extensions defaultExtensionNs="com.intellij">
    <stubElementTypeHolder externalIdPrefix="c3."
                           class="org.c3lang.intellij.psi.C3Types"/>
    <stubIndex implementation="org.c3lang.intellij.index.ModuleIndex"/>
    <stubIndex implementation="org.c3lang.intellij.index.NameIndex"/>
    <stubIndex implementation="org.c3lang.intellij.index.TypeIndex"/>
    <stubIndex implementation="org.c3lang.intellij.index.AttributeIndex"/>
    <stubIndex implementation="org.c3lang.intellij.index.ReturnTypeIndex"/>
    <stubIndex implementation="org.c3lang.intellij.index.StructDeclarationIndex"/>
    <stubIndex implementation="org.c3lang.intellij.index.StructMemberDeclarationIndex"/>

    <additionalLibraryRootsProvider implementation="org.c3lang.intellij.C3StdLibRootsProvider"/>
    <additionalLibraryRootsProvider implementation="org.c3lang.intellij.C3ProjectLibrariesRootsProvider"/>
    <fileType name="C3 File"
              implementationClass="org.c3lang.intellij.C3SourceFileType"
              fieldName="INSTANCE"
              language="C3"
              extensions="c3;c3t"/>
    <fileType name="C3 Interface File"
              implementationClass="org.c3lang.intellij.C3InterfaceFileType"
              fieldName="INSTANCE"
              language="C3"
              extensions="c3i"/>
    <!--<fileType name="C3 Library File"
                  implementationClass="org.c3lang.intellij.C3LibFileType"
                  fieldName="INSTANCE"
                  language="C3"
                  extensions="c3l"/>-->

    <lang.parserDefinition language="C3"
                           implementationClass="org.c3lang.intellij.C3ParserDefinition"/>
    <lang.syntaxHighlighterFactory language="C3"
                                   implementationClass="org.c3lang.intellij.C3SyntaxHighlighterFactory"/>
    <lang.braceMatcher language="C3"
                       implementationClass="org.c3lang.intellij.C3BraceMatcher"/>
    <lang.commenter language="C3"
                    implementationClass="org.c3lang.intellij.C3Commenter"/>
    <lang.formatter language="C3"
                    implementationClass="org.c3lang.intellij.formatter.C3FormattingModelBuilder"/>
    <lang.quoteHandler language="C3"
                       implementationClass="org.c3lang.intellij.C3QuoteHandler"/>
    <lang.findUsagesProvider language="C3"
                             implementationClass="org.c3lang.intellij.findUsages.C3FindUsagesProvider"/>
    <lang.psiStructureViewFactory language="C3"
                                  implementationClass="org.c3lang.intellij.structure.C3StructureViewFactory"/>
    <gotoSymbolContributor implementation="org.c3lang.intellij.C3SymbolContributor"/>
    <gotoDeclarationHandler implementation="org.c3lang.intellij.navigation.C3AtMacroGotoDeclarationHandler"/>
    <lang.documentationProvider language="C3"
                                implementationClass="org.c3lang.intellij.docs.C3DocumentationProvider" />
    <psi.referenceContributor language="C3"
                              implementation="org.c3lang.intellij.psi.reference.C3ReferenceContributor" />
    <referencesSearch implementation="org.c3lang.intellij.findUsages.C3EnumConstantReferencesSearch" />
    <usageTypeProvider implementation="org.c3lang.intellij.findUsages.C3UsageTypeProvider" />
    <readWriteAccessDetector implementation="org.c3lang.intellij.findUsages.C3ReadWriteAccessDetector" />
    <typedHandler implementation="org.c3lang.intellij.C3DocCommentTypedHandler" />
    <enterHandlerDelegate implementation="org.c3lang.intellij.C3DocCommentEnterHandler" />
    <lang.elementManipulator implementationClass="org.c3lang.intellij.psi.NamedElementManipulator"
                             forClass="org.c3lang.intellij.psi.C3PsiNamedElement" />
    <renameHandler implementation="org.c3lang.intellij.refactoring.C3ModuleRenameHandler"/>
    <!--<lang.foldingBuilder language="JAVA"
                             implementationClass="org.intellij.sdk.language.SimpleFoldingBuilder"/>-->
    <!--<lang.psiStructureViewFactory language="Simple"
                                  implementationClass="org.intellij.sdk.language.SimpleStructureViewFactory"/>-->
    <!--<lang.formatter language="Simple"
                        implementationClass="org.intellij.sdk.language.SimpleFormattingModelBuilder"/>-->
    
    
    <annotator language="C3"
               implementationClass="org.c3lang.intellij.annotation.C3Annotator"/>
    <completion.contributor language="C3"
                            implementationClass="org.c3lang.intellij.completion.C3CompletionContributor" />
    <codeInsight.lineMarkerProvider language="C3"
                                    implementationClass="org.c3lang.intellij.C3LineMarkerProvider" />
    <codeInsight.parameterInfo language="C3"
                               implementationClass="org.c3lang.intellij.C3ParameterInfoHandler" />
    <consoleFilterProvider implementation="org.c3lang.intellij.C3ConsoleFilterProvider" />
    <multiHostInjector implementation="org.c3lang.intellij.injection.C3LanguageInjector" />
    <!--<completion.contributor language="C3"
                                implementationClass="org.c3lang.intellij.C3CompletionContributor" />-->
    <!--<psi.referenceProvider providerClass="org.c3lang.intellij.C3PsiReferenceProvider" />-->
    <!--<codeInsight.lineMarkerProvider language="JAVA"
                                        implementationClass="org.intellij.sdk.language.SimpleLineMarkerProvider"/>-->
    <!--<psi.referenceContributor implementation="org.intellij.sdk.language.SimpleReferenceContributor"/>-->

    <localInspection language="C3"
                     displayName="Import module"
                     groupName="Import group"
                     enabledByDefault="true"
                     level="WARNING"
                     implementationClass="org.c3lang.intellij.intention.ImportModuleInspection" />
    <localInspection language="C3"
                     displayName="Unimplemented interface methods"
                     groupName="C3"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="org.c3lang.intellij.intention.C3InterfaceImplementationInspection" />
    <localInspection language="C3"
                     displayName="Unresolved type"
                     groupName="C3"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="org.c3lang.intellij.intention.C3UnresolvedTypeInspection" />
    <localInspection language="C3"
                     enabledByDefault="true"
                     displayName="Log references"
                     groupName="Debug"
                     implementationClass="org.c3lang.intellij.intention.LogReferencesInspection" />
    <localInspection language="C3"
                     displayName="Unused declaration"
                     groupName="C3"
                     enabledByDefault="true"
                     level="WARNING"
                     implementationClass="org.c3lang.intellij.intention.C3UnusedDeclarationInspection" />
    <localInspection language="C3"
                     displayName="Unused expression result"
                     groupName="C3"
                     enabledByDefault="true"
                     level="WARNING"
                     implementationClass="org.c3lang.intellij.intention.C3UnusedExpressionResultInspection" />
    <localInspection language="C3"
                     displayName="Unknown named argument"
                     groupName="C3"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="org.c3lang.intellij.intention.C3NamedArgumentInspection" />
    <localInspection language="C3"
                     displayName="Duplicate variable declaration"
                     groupName="C3"
                     enabledByDefault="true"
                     level="ERROR"
                     implementationClass="org.c3lang.intellij.intention.C3DuplicateVariableInspection" />
    <!-- TODO: Enable after grammar rewrite -->
    <!--<localInspection language="C3"
                         enabledByDefault="true"
                         displayName="Call expressions"
                         groupName="Call expressions"
                         level="WARNING"
                         implementationClass="org.c3lang.intellij.intention.CallExprInspection" />-->

    <additionalTextAttributes scheme="Default" file="colors/c3_default.xml"/>
    <additionalTextAttributes scheme="Darcula" file="colors/c3_darcula.xml"/>
    <intentionAction>
      <language>C3</language>
      <className>org.c3lang.intellij.intention.ImplementOptionalInterfaceMethodsIntention</className>
      <category>C3</category>
    </intentionAction>

    <colorSettingsPage implementation="org.c3lang.intellij.C3ColorSettingsPage"/>
    <colorProvider implementation="org.c3lang.intellij.C3ElementColorProvider" />
    <breadcrumbsInfoProvider implementation="org.c3lang.intellij.C3BreadcrumbsProvider"/>
    <editorNotificationProvider implementation="org.c3lang.intellij.actions.C3EditorNotificationProvider" />

    <applicationConfigurable id="org.c3lang.compiler"
                             displayName="C3 Compiler"
                             parentId="build"
                             instance="org.c3lang.intellij.C3CompilerConfigurable" />
    <applicationService serviceImplementation="org.c3lang.intellij.C3SettingsState"/>

    <projectConfigurable instance="org.c3lang.intellij.settings.C3Configurable"
                         parentId="language"
                         id="c3.language.settings"
                         displayName="C3" />
    
    <sdkType implementation="org.c3lang.intellij.C3SdkType"/>
    <newProjectWizard.languageGenerator implementation="org.c3lang.intellij.wizard.C3NewProjectWizard"/>
    <newProjectWizard.languageGenerator implementation="org.c3lang.intellij.wizard.C3NewLibraryWizard"/>
    <!--<projectSdkSetupValidator implementation="" />-->
 
    <configurationType implementation="org.c3lang.intellij.C3ConfigurationType"/>
 
    <postStartupActivity implementation="org.c3lang.intellij.actions.StartupAction" />

    <projectService serviceImplementation="org.c3lang.intellij.autorerun.C3AutoRerunService"/>
    <postStartupActivity implementation="org.c3lang.intellij.autorerun.C3AutoRerunStartupActivity"/>

    <!--<gotoDeclarationHandler implementation="org.c3lang.intellij.actions.C3GotoDeclarationHandler"/>-->
    <!--<findUsagesHandlerFactory implementation="org.c3lang.intellij.findUsages.C3FindUsagesHandlerFactory" />-->
    <!--<gotoSymbolContributor implementation="org.intellij.sdk.language.SimpleChooseByNameContributor"/>-->
    <!--<codeStyleSettingsProvider implementation="org.intellij.sdk.language.SimpleCodeStyleSettingsProvider"/>-->
    <!--<langCodeStyleSettingsProvider implementation="org.intellij.sdk.language.SimpleLanguageCodeStyleSettingsProvider"/>-->
  </extensions>

    <applicationListeners>
        <listener class="org.c3lang.intellij.autorerun.C3AutoRerunFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <actions>
        <action id="C3.ToggleAutoRerun"
                class="org.c3lang.intellij.autorerun.C3ToggleAutoRerunAction"
                icon="AllIcons.Actions.Rerun"
                text="Auto-Rerun C3 on Change"
                description="When enabled, automatically save and re-run the selected C3 run/test configuration shortly after you stop typing in a C3 file (or when project.json changes).">
            <!-- New UI run widget: sit between the config selector and the Run button. -->
            <add-to-group group-id="RunToolbarMainActionGroup" anchor="before"
                          relative-to-action="RunToolbarTopLevelExecutorActionGroup"/>
            <!-- Classic UI main toolbar run cluster. -->
            <add-to-group group-id="ToolbarRunGroup" anchor="first"/>
            <add-to-group group-id="RunMenu" anchor="last"/>
        </action>
        <action id="C3NewInterfaceFileAction"
                class="org.c3lang.intellij.actions.C3NewInterfaceFileAction"
                text="C3 Interface File">
            <add-to-group group-id="NewGroup"
                          anchor="first"/>
        </action>
        <action id="C3NewFileAction"
                class="org.c3lang.intellij.actions.C3NewFileAction"
                text="C3 File">
            <add-to-group group-id="NewGroup"
                          anchor="first"/>
        </action>
        <action id="C3MoveTypeToFileAction"
                class="org.c3lang.intellij.actions.C3MoveTypeToFileAction"
                text="Move Type to File..."
                description="Move the type under the caret and its member functions into a new file in the same module.">
            <add-to-group group-id="RefactoringMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
